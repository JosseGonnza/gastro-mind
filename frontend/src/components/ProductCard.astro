---
import AllergenIcon from './AllergenIcon.astro';
import { CATEGORY_STYLES, UNIT_LABELS } from '../lib/catalog';
import type { Product } from '../lib/api';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const style = CATEGORY_STYLES[product.category];
---

<article
  class="flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-stone-200/70 transition hover:-translate-y-0.5 hover:shadow-md"
>
  <div class:list={['h-2', style.band]}></div>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-start justify-between gap-3">
      <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-semibold', style.chip]}>{style.label}</span>
      <span class="rounded-md bg-stone-100 px-2 py-0.5 text-xs font-medium text-stone-600">
        {UNIT_LABELS[product.unit]}
      </span>
    </div>

    <div>
      <h3 class="text-lg leading-tight font-bold text-stone-900">{product.name}</h3>
      {product.description && <p class="mt-1 text-sm text-stone-500">{product.description}</p>}
    </div>

    <div class="mt-auto border-t border-dashed border-stone-200 pt-3">
      {
        product.allergens.length > 0 ? (
          <ul class="flex flex-wrap gap-1.5" aria-label="Alérgenos">
            {product.allergens.map((allergen) => (
              <li class="grid size-10 place-items-center rounded-full bg-stone-50 ring-1 ring-stone-200">
                <AllergenIcon allergen={allergen} size={26} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-xs font-semibold text-emerald-700">Sin alérgenos declarados</p>
        )
      }
    </div>
  </div>
</article>
