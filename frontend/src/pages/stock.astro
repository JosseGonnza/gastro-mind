---
import { API_URL } from 'astro:env/server';
import Layout from '../layouts/Layout.astro';
import AllergenIcon from '../components/AllergenIcon.astro';
import ExpiryBadge from '../components/ExpiryBadge.astro';
import { getStock, type ProductStock } from '../lib/api';
import { CATEGORY_STYLES } from '../lib/catalog';
import { expiryStatus, todayIso } from '../lib/expiry';
import { formatDate, formatMoney, formatQuantity } from '../lib/format';

let stock: ProductStock[] = [];
let apiDown = false;
try {
  stock = await getStock(API_URL);
} catch {
  apiDown = true;
}

const today = todayIso();
const batchCount = stock.reduce((count, product) => count + product.batches.length, 0);
const needsAttention = stock
  .flatMap((product) => product.batches)
  .filter((batch) => expiryStatus(batch.expirationDate, today).level !== 'ok').length;

const receivedNumber = Astro.url.searchParams.get('albaran');
const receivedTotal = Number(Astro.url.searchParams.get('total'));

const kpis = [
  { label: 'Productos en cámara', value: stock.length, alert: false },
  { label: 'Lotes', value: batchCount, alert: false },
  { label: 'Caducan en menos de 5 días', value: needsAttention, alert: needsAttention > 0 },
];
---

<Layout title="En cámara" subtitle="Qué hay de cada producto, en qué lotes y cuándo caduca">
  <a slot="actions" href="/albaranes/nuevo" class="btn-primary">+ Nuevo albarán</a>

  {
    receivedNumber && (
      <p class="notice-success mb-6">
        Albarán {receivedNumber} registrado{Number.isFinite(receivedTotal) && receivedTotal > 0 && ` · ${formatMoney(receivedTotal)}`}.
      </p>
    )
  }

  {
    apiDown ? (
      <div class="panel p-8 text-center">
        <p class="font-semibold text-red-700">No se puede conectar con la API</p>
        <p class="mt-1 text-sm text-stone-500">
          Comprueba que el backend está arrancado en <code class="rounded bg-stone-100 px-1.5">{API_URL}</code>.
        </p>
      </div>
    ) : (
      <>
        <dl class="mb-6 grid grid-cols-3 gap-2 sm:gap-4">
          {kpis.map(({ label, value, alert }) => (
            <div class="panel px-3 py-3 sm:px-5 sm:py-4">
              <dt class="text-[10px] leading-tight font-semibold tracking-wide text-stone-500 uppercase sm:text-xs">{label}</dt>
              <dd class:list={['mt-1 text-2xl font-bold tabular-nums sm:text-3xl', alert ? 'text-red-600' : 'text-stone-900']}>{value}</dd>
            </div>
          ))}
        </dl>

        {stock.length === 0 ? (
          <div class="panel p-10 text-center">
            <p class="font-semibold text-stone-700">La cámara está vacía</p>
            <p class="mt-1 text-sm text-stone-500">Registra un albarán para dar entrada al género.</p>
          </div>
        ) : (
          <div class="panel overflow-x-auto">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Producto</th>
                  <th class="num">Cantidad</th>
                  <th>Caducidad</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody>
                {stock.map((product) => {
                  const style = CATEGORY_STYLES[product.category];
                  const next = product.batches[0];
                  const single = product.batches.length === 1;
                  return (
                    <>
                      <tr class:list={[!single && 'bg-stone-50/70']}>
                        <td>
                          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                            <span class="font-semibold text-stone-900">{product.name}</span>
                            <span class="inline-flex items-center gap-1.5 text-xs text-stone-500">
                              <span class:list={['size-2 rounded-full', style.band]} />
                              {style.label}
                            </span>
                            {product.allergens.length > 0 && (
                              <span class="flex gap-0.5" aria-label="Alérgenos">
                                {product.allergens.map((allergen) => (
                                  <AllergenIcon allergen={allergen} size={16} />
                                ))}
                              </span>
                            )}
                          </div>
                          {single && <p class="mt-0.5 font-mono text-xs text-stone-400">Lote {next.lotCode}</p>}
                        </td>
                        <td class="num font-semibold text-stone-900">{formatQuantity(product.total, product.unit)}</td>
                        <td class="whitespace-nowrap text-stone-600">
                          {single ? formatDate(next.expirationDate) : `${product.batches.length} lotes · desde ${formatDate(next.expirationDate)}`}
                        </td>
                        <td>
                          <ExpiryBadge expirationDate={next.expirationDate} today={today} />
                        </td>
                      </tr>
                      {!single &&
                        product.batches.map((batch) => (
                          <tr class="text-stone-600">
                            <td class="pl-8 font-mono text-xs">Lote {batch.lotCode}</td>
                            <td class="num">{formatQuantity(batch.quantity, product.unit)}</td>
                            <td class="whitespace-nowrap">{formatDate(batch.expirationDate)}</td>
                            <td>
                              <ExpiryBadge expirationDate={batch.expirationDate} today={today} />
                            </td>
                          </tr>
                        ))}
                    </>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </>
    )
  }
</Layout>
