---
import type { Product } from '../lib/api';
import { UNITS, UNIT_LABELS } from '../lib/catalog';
import type { ReceiptFormRow } from '../lib/receipt-form';
import { RECEIPT_LINE_GRID } from '../lib/receipt-grid';

interface Props {
  products: Product[];
  row?: ReceiptFormRow;
  minDate: string;
}

const { products, row, minDate } = Astro.props;
const values: ReceiptFormRow = row ?? {
  productId: '',
  quantity: '',
  unit: 'KILOGRAM',
  amount: '',
  expirationDate: '',
  lotCode: '',
};
---

<div data-line class:list={['grid grid-cols-2 gap-x-3 gap-y-2 border-b border-stone-100 px-4 py-3 sm:grid-cols-4 lg:items-center lg:py-2', RECEIPT_LINE_GRID]}>
  <label class="col-span-2 block sm:col-span-4 lg:col-span-1">
    <span class="field-label lg:sr-only">Producto</span>
    <select name="productId" data-product class="field lg:mt-0">
      <option value="">Elige un producto…</option>
      {
        products.map((product) => (
          <option value={product.id} data-unit={product.unit} selected={product.id === values.productId}>
            {product.name}
          </option>
        ))
      }
    </select>
  </label>
  <label class="block">
    <span class="field-label lg:sr-only">Cantidad</span>
    <input name="quantity" inputmode="decimal" placeholder="2,5" value={values.quantity} class="field text-right tabular-nums lg:mt-0" />
  </label>
  <label class="block">
    <span class="field-label lg:sr-only">Unidad</span>
    <select name="unit" data-unit-select class="field lg:mt-0">
      {
        UNITS.map((unit) => (
          <option value={unit} selected={unit === values.unit}>
            {UNIT_LABELS[unit]}
          </option>
        ))
      }
    </select>
  </label>
  <label class="block">
    <span class="field-label lg:sr-only">Importe (€)</span>
    <input name="amount" inputmode="decimal" placeholder="37,50" value={values.amount} class="field text-right tabular-nums lg:mt-0" />
  </label>
  <label class="block">
    <span class="field-label lg:sr-only">Caducidad</span>
    <input name="expirationDate" type="date" min={minDate} value={values.expirationDate} class="field lg:mt-0" />
  </label>
  <label class="col-span-2 block sm:col-span-1">
    <span class="field-label lg:sr-only">Lote</span>
    <input name="lotCode" maxlength="50" placeholder="Opcional" value={values.lotCode} class="field font-mono lg:mt-0" />
  </label>
</div>
