---
import { API_URL } from 'astro:env/server';
import Layout from '../layouts/Layout.astro';
import AllergenIcon from '../components/AllergenIcon.astro';
import { listProducts, type Product } from '../lib/api';
import { ALLERGENS, ALLERGEN_LABELS, CATEGORY_STYLES, UNIT_LABELS } from '../lib/catalog';
import { describeExcluded, filterProducts, parseExcluded, toggleHref } from '../lib/filter';

let products: Product[] = [];
let apiDown = false;
try {
  products = await listProducts(API_URL);
} catch {
  apiDown = true;
}

const created = Astro.url.searchParams.get('creado');
const excluded = parseExcluded(Astro.url.searchParams);
const visible = filterProducts(products, excluded);
const filtering = excluded.length > 0;
const plural = (count: number) => (count === 1 ? 'producto' : 'productos');
const subtitle = apiDown
  ? 'Sin conexión con la API'
  : filtering
    ? `${visible.length} de ${products.length} ${plural(products.length)}`
    : `${products.length} ${plural(products.length)}`;
---

<Layout title="Productos" subtitle={subtitle}>
  <a slot="actions" href="/productos/nuevo" class="btn-primary">+ Nuevo producto</a>

  {created && <p class="notice-success mb-6">«{created}» añadido al catálogo.</p>}

  {
    apiDown ? (
      <div class="panel p-8 text-center">
        <p class="font-semibold text-red-700">No se puede conectar con la API</p>
        <p class="mt-1 text-sm text-stone-500">
          Comprueba que el backend está arrancado en <code class="rounded bg-stone-100 px-1.5">{API_URL}</code>.
        </p>
      </div>
    ) : (
      <div class="panel overflow-hidden">
        <div class="border-b border-stone-200 px-4 py-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="text-xs font-semibold tracking-wide text-stone-500 uppercase">Sin alérgenos</p>
            {filtering && (
              <a href="/" class="text-xs font-semibold text-brasa-oscura hover:underline">
                Quitar filtros
              </a>
            )}
          </div>
          <ul class="mt-2 flex flex-wrap gap-1.5">
            {ALLERGENS.map((allergen) => {
              const active = excluded.includes(allergen);
              return (
                <li>
                  <a
                    href={toggleHref(excluded, allergen)}
                    class:list={[
                      'flex items-center gap-1.5 rounded-md py-1 pr-2.5 pl-1.5 text-xs font-medium transition',
                      active
                        ? 'bg-orange-50 text-stone-900 ring-1 ring-brasa'
                        : 'bg-white text-stone-600 ring-1 ring-stone-200 hover:ring-stone-300',
                    ]}
                  >
                    <AllergenIcon allergen={allergen} size={16} />
                    {ALLERGEN_LABELS[allergen]}
                    {active && (
                      <span aria-hidden="true" class="font-bold text-brasa-oscura">
                        ✕
                      </span>
                    )}
                    <span class="sr-only">{active ? '(evitado; pulsa para quitarlo)' : '(pulsa para evitarlo)'}</span>
                  </a>
                </li>
              );
            })}
          </ul>
          {filtering && (
            <p class="mt-3 text-sm text-stone-700">
              <strong>Apto sin {describeExcluded(excluded)}:</strong> {visible.length} de {products.length} {plural(products.length)}.
            </p>
          )}
        </div>

        {products.length === 0 ? (
          <p class="p-10 text-center text-sm text-stone-500">El catálogo está vacío: da de alta tu primer producto.</p>
        ) : visible.length === 0 ? (
          <p class="p-10 text-center text-sm text-stone-500">Ningún producto está libre de {describeExcluded(excluded)}.</p>
        ) : (
          <div class="overflow-x-auto">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Producto</th>
                  <th>Categoría</th>
                  <th>Unidad</th>
                  <th>Alérgenos</th>
                </tr>
              </thead>
              <tbody>
                {visible.map((product) => {
                  const style = CATEGORY_STYLES[product.category];
                  return (
                    <tr class="hover:bg-stone-50">
                      <td>
                        <p class="font-semibold text-stone-900">{product.name}</p>
                        {product.description && <p class="text-xs text-stone-500">{product.description}</p>}
                      </td>
                      <td class="whitespace-nowrap">
                        <span class="inline-flex items-center gap-1.5 text-stone-600">
                          <span class:list={['size-2 rounded-full', style.band]} />
                          {style.label}
                        </span>
                      </td>
                      <td class="text-stone-600">{UNIT_LABELS[product.unit]}</td>
                      <td>
                        {product.allergens.length > 0 ? (
                          <span class="flex gap-1">
                            {product.allergens.map((allergen) => (
                              <AllergenIcon allergen={allergen} size={20} />
                            ))}
                          </span>
                        ) : (
                          <span class="text-xs text-stone-400">—</span>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>
    )
  }
</Layout>
