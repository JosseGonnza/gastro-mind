---
import { API_URL } from 'astro:env/server';
import Layout from '../../layouts/Layout.astro';
import { ApiError, createSupplier } from '../../lib/api';

let error: string | null = null;
let values = { name: '', taxId: '', phone: '', email: '' };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  values = {
    name: String(form.get('name') ?? ''),
    taxId: String(form.get('taxId') ?? ''),
    phone: String(form.get('phone') ?? ''),
    email: String(form.get('email') ?? ''),
  };
  try {
    const supplier = await createSupplier(API_URL, {
      name: values.name,
      taxId: values.taxId || undefined,
      phone: values.phone || undefined,
      email: values.email || undefined,
    });
    return Astro.redirect(`/proveedores?creado=${encodeURIComponent(supplier.name)}`);
  } catch (e) {
    error =
      e instanceof ApiError
        ? `La API ha rechazado el proveedor: ${e.message}`
        : 'No se puede conectar con la API. ¿Está arrancada?';
  }
}
---

<Layout title="Nuevo proveedor" subtitle="Solo el nombre es obligatorio">
  <a slot="actions" href="/proveedores" class="btn-secondary">← Volver a proveedores</a>

  {error && <p class="notice-error mb-6">{error}</p>}

  <form method="post" class="panel grid max-w-3xl gap-5 p-6 sm:grid-cols-2">
    <label class="block sm:col-span-2">
      <span class="field-label">Nombre</span>
      <input name="name" required pattern=".*\S.*" maxlength="100" value={values.name} class="field" />
    </label>
    <label class="block">
      <span class="field-label">CIF <span class="font-normal text-stone-400">(opcional)</span></span>
      <input name="taxId" maxlength="20" value={values.taxId} class="field" />
    </label>
    <label class="block">
      <span class="field-label">Teléfono <span class="font-normal text-stone-400">(opcional)</span></span>
      <input name="phone" type="tel" maxlength="30" value={values.phone} class="field" />
    </label>
    <label class="block sm:col-span-2">
      <span class="field-label">Email <span class="font-normal text-stone-400">(opcional)</span></span>
      <input name="email" type="email" maxlength="100" value={values.email} class="field" />
    </label>
    <div class="flex gap-2 border-t border-stone-100 pt-5 sm:col-span-2">
      <button type="submit" class="btn-primary">Guardar proveedor</button>
      <a href="/proveedores" class="btn-secondary">Cancelar</a>
    </div>
  </form>
</Layout>
