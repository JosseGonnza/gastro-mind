---
import { API_URL } from 'astro:env/server';
import Layout from '../../layouts/Layout.astro';
import AllergenIcon from '../../components/AllergenIcon.astro';
import { ApiError, createProduct } from '../../lib/api';
import {
  ALLERGENS,
  ALLERGEN_LABELS,
  CATEGORIES,
  CATEGORY_STYLES,
  UNITS,
  UNIT_LABELS,
  type Allergen,
  type Category,
  type Unit,
} from '../../lib/catalog';

let error: string | null = null;
let values = {
  name: '',
  description: '',
  category: 'VEGETABLE' as Category,
  unit: 'KILOGRAM' as Unit,
  allergens: [] as Allergen[],
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  values = {
    name: String(form.get('name') ?? ''),
    description: String(form.get('description') ?? ''),
    category: String(form.get('category')) as Category,
    unit: String(form.get('unit')) as Unit,
    allergens: form.getAll('allergens').map(String) as Allergen[],
  };
  try {
    const product = await createProduct(API_URL, {
      name: values.name,
      description: values.description || undefined,
      category: values.category,
      unit: values.unit,
      allergens: values.allergens,
    });
    return Astro.redirect(`/?creado=${encodeURIComponent(product.name)}`);
  } catch (e) {
    error =
      e instanceof ApiError
        ? `La API ha rechazado el producto: ${e.message}`
        : 'No se puede conectar con la API. ¿Está arrancada?';
  }
}
---

<Layout title="Nuevo producto" subtitle="Ficha de producto con su categoría, unidad y alérgenos">
  <a slot="actions" href="/" class="btn-secondary">← Volver a productos</a>

  {error && <p class="notice-error mb-6">{error}</p>}

  <form method="post" class="panel grid gap-8 p-6 lg:grid-cols-[1fr_1.3fr]">
    <div class="space-y-5">
      <label class="block">
        <span class="field-label">Nombre</span>
        <input name="name" required pattern=".*\S.*" maxlength="100" value={values.name} class="field" />
      </label>

      <label class="block">
        <span class="field-label">Descripción <span class="font-normal text-stone-400">(opcional)</span></span>
        <textarea name="description" rows="3" class="field">{values.description}</textarea>
      </label>

      <div class="grid grid-cols-2 gap-4">
        <label class="block">
          <span class="field-label">Categoría</span>
          <select name="category" class="field">
            {
              CATEGORIES.map((category) => (
                <option value={category} selected={category === values.category}>
                  {CATEGORY_STYLES[category].label}
                </option>
              ))
            }
          </select>
        </label>

        <label class="block">
          <span class="field-label">Unidad</span>
          <select name="unit" class="field">
            {
              UNITS.map((unit) => (
                <option value={unit} selected={unit === values.unit}>
                  {UNIT_LABELS[unit]}
                </option>
              ))
            }
          </select>
        </label>
      </div>
    </div>

    <fieldset>
      <legend class="field-label">Alérgenos</legend>
      <p class="text-xs text-stone-500">Marca todos los que contenga el producto.</p>
      <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
        {
          ALLERGENS.map((allergen) => (
            <label class="flex cursor-pointer items-center gap-2 rounded-lg bg-white px-2.5 py-2 text-sm font-medium text-stone-700 ring-1 ring-stone-200 transition select-none hover:ring-stone-300 has-[:checked]:bg-orange-50 has-[:checked]:text-stone-900 has-[:checked]:ring-2 has-[:checked]:ring-brasa">
              <input
                type="checkbox"
                name="allergens"
                value={allergen}
                checked={values.allergens.includes(allergen)}
                class="sr-only"
              />
              <AllergenIcon allergen={allergen} size={22} />
              {ALLERGEN_LABELS[allergen]}
            </label>
          ))
        }
      </div>
    </fieldset>

    <div class="flex gap-2 border-t border-stone-100 pt-5 lg:col-span-2">
      <button type="submit" class="btn-primary">Guardar producto</button>
      <a href="/" class="btn-secondary">Cancelar</a>
    </div>
  </form>
</Layout>
