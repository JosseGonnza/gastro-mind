---
import { API_URL } from 'astro:env/server';
import Layout from '../../layouts/Layout.astro';
import { listSuppliers, type Supplier } from '../../lib/api';

let suppliers: Supplier[] = [];
let apiDown = false;
try {
  suppliers = await listSuppliers(API_URL);
} catch {
  apiDown = true;
}

const created = Astro.url.searchParams.get('creado');
const subtitle = apiDown
  ? 'Sin conexión con la API'
  : `${suppliers.length} ${suppliers.length === 1 ? 'proveedor' : 'proveedores'}`;
---

<Layout title="Proveedores" subtitle={subtitle}>
  <a slot="actions" href="/proveedores/nuevo" class="btn-primary">+ Nuevo proveedor</a>

  {created && <p class="notice-success mb-6">«{created}» añadido a tus proveedores.</p>}

  {
    apiDown ? (
      <div class="panel p-8 text-center">
        <p class="font-semibold text-red-700">No se puede conectar con la API</p>
        <p class="mt-1 text-sm text-stone-500">
          Comprueba que el backend está arrancado en <code class="rounded bg-stone-100 px-1.5">{API_URL}</code>.
        </p>
      </div>
    ) : suppliers.length === 0 ? (
      <div class="panel p-10 text-center">
        <p class="font-semibold text-stone-700">Todavía no hay proveedores</p>
        <p class="mt-1 text-sm text-stone-500">Da de alta al primero para poder registrar sus albaranes.</p>
      </div>
    ) : (
      <div class="panel overflow-x-auto">
        <table class="data-table">
          <thead>
            <tr>
              <th>Proveedor</th>
              <th>CIF</th>
              <th>Teléfono</th>
              <th>Email</th>
            </tr>
          </thead>
          <tbody>
            {suppliers.map((supplier) => (
              <tr class="hover:bg-stone-50">
                <td class="font-semibold text-stone-900">{supplier.name}</td>
                <td class="font-mono text-xs text-stone-600">{supplier.taxId ?? <span class="font-sans text-stone-400">—</span>}</td>
                <td class="whitespace-nowrap text-stone-600">
                  {supplier.phone ? (
                    <a href={`tel:${supplier.phone.replaceAll(' ', '')}`} class="hover:underline">
                      {supplier.phone}
                    </a>
                  ) : (
                    <span class="text-stone-400">—</span>
                  )}
                </td>
                <td class="text-stone-600">
                  {supplier.email ? (
                    <a href={`mailto:${supplier.email}`} class="hover:underline">
                      {supplier.email}
                    </a>
                  ) : (
                    <span class="text-stone-400">—</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</Layout>
