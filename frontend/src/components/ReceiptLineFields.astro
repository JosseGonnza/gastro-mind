---
import type { Product } from '../lib/api';
import { UNITS, UNIT_LABELS } from '../lib/catalog';
import type { ReceiptFormRow } from '../lib/receipt-form';

interface Props {
  products: Product[];
  row?: ReceiptFormRow;
  minDate: string;
}

const { products, row, minDate } = Astro.props;
const values: ReceiptFormRow = row ?? {
  productId: '',
  quantity: '',
  unit: 'KILOGRAM',
  amount: '',
  expirationDate: '',
  lotCode: '',
};

const label = 'text-xs font-semibold text-stone-500';
const field =
  'mt-1 w-full rounded-lg border-0 bg-white px-3 py-2 text-sm text-stone-900 ring-1 ring-stone-300 focus:ring-2 focus:ring-brasa focus:outline-none';
---

<div data-line class="grid grid-cols-2 gap-3 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-stone-200/70 sm:grid-cols-4 lg:grid-cols-8">
  <label class="col-span-2 block">
    <span class={label}>Producto</span>
    <select name="productId" data-product class={field}>
      <option value="">Elige un producto…</option>
      {
        products.map((product) => (
          <option value={product.id} data-unit={product.unit} selected={product.id === values.productId}>
            {product.name}
          </option>
        ))
      }
    </select>
  </label>
  <label class="block">
    <span class={label}>Cantidad</span>
    <input name="quantity" inputmode="decimal" placeholder="2,5" value={values.quantity} class={field} />
  </label>
  <label class="block">
    <span class={label}>Unidad</span>
    <select name="unit" data-unit-select class={field}>
      {
        UNITS.map((unit) => (
          <option value={unit} selected={unit === values.unit}>
            {UNIT_LABELS[unit]}
          </option>
        ))
      }
    </select>
  </label>
  <label class="block">
    <span class={label}>Importe (€)</span>
    <input name="amount" inputmode="decimal" placeholder="37,50" value={values.amount} class={field} />
  </label>
  <label class="col-span-2 block">
    <span class={label}>Caducidad</span>
    <input name="expirationDate" type="date" min={minDate} value={values.expirationDate} class={field} />
  </label>
  <label class="col-span-2 block sm:col-span-1">
    <span class={label}>Lote <span class="font-normal text-stone-400">(opcional)</span></span>
    <input name="lotCode" maxlength="50" value={values.lotCode} class={field} />
  </label>
</div>
