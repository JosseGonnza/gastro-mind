---
import '@fontsource-variable/figtree';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname;

const links = [
  { href: '/', label: 'Catálogo', section: '/productos' },
  { href: '/stock', label: 'En cámara', section: '/stock' },
  { href: '/albaranes/nuevo', label: 'Nuevo albarán', section: '/albaranes' },
  { href: '/proveedores', label: 'Proveedores', section: '/proveedores' },
];
const isActive = (href: string, section: string) => path === href || path.startsWith(section);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Gastro Mind</title>
  </head>
  <body class="flex min-h-dvh flex-col bg-crema font-sans text-stone-800 antialiased">
    <header class="bg-linear-to-r from-trigo via-melocoton to-brasa shadow-sm">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-4 sm:px-6">
        <a href="/" class="flex items-center gap-2.5 text-xl font-extrabold tracking-tight text-stone-900">
          <img src="/favicon.svg" alt="" class="size-9" />
          Gastro Mind
        </a>
        <nav class="flex flex-wrap gap-1 text-sm font-semibold">
          {
            links.map(({ href, label, section }) => (
              <a
                href={href}
                class:list={[
                  'rounded-full px-4 py-2 transition',
                  isActive(href, section) ? 'bg-white/80 text-stone-900 shadow-sm' : 'text-stone-800 hover:bg-white/40',
                ]}
              >
                {label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6">
      <slot />
    </main>

    <footer class="border-t border-stone-200/70 py-6 text-center text-xs text-stone-500">
      Gastro Mind · ERP de hostelería · Iconos de alérgenos basados en Fluent Emoji (Microsoft, MIT)
    </footer>
  </body>
</html>
